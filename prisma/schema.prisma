generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Quality {
  FIRST
  END
}

enum Surface {
  MAT
  SLP
  FLP
  SGR
  GLS
  SOFT_ANTISLIP
  ANTISLIP
  R10
  R11
}

enum OrderStatus {
  NEW
  CORRECTION_REQUESTED
  REVIEWED
  APPROVED
  REJECTED
}

enum AdminRole {
  SUPER
  BRAND_MANAGER
}

enum AccessRequestType {
  SALESPERSON
  DEALER
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FilterBasis {
  FAMILY
  VARIANT
}

model Brand {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  logoText  String?
  sortOrder Int             @default(0)
  /** false ise marka katalogda hiç görünmez (her izleyici için gizli). */
  isVisible Boolean         @default(true)
  /** false ise marka yalnızca plasiyerlere görünür, bayilere kapalıdır. */
  visibleToDealers Boolean  @default(true)
  families      ProductFamily[]
  admins        AdminUser[]
  announcements Announcement[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ProductFamily {
  id             String           @id @default(cuid())
  brandId        String
  brand          Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  imageUrl       String?
  imagePublicId  String?
  imageUpdatedAt DateTime?
  sortOrder      Int              @default(0)
  isActive       Boolean          @default(true)
  /** Önceden tanımlı renk kimliği (product-attributes.ts). */
  color          String?
  /** Önceden tanımlı görünüm/tip kimliği: mermer, ahsap, beton... */
  materialType   String?
  variants       ProductVariant[]
  clickStat      FamilyClickStat?
  clickEvents    FamilyClickEvent[]
  similarOf      SimilarFamily[]  @relation("FamilyToSimilar")
  similarTo      SimilarFamily[]  @relation("SimilarToFamily")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([brandId, slug])
  @@index([brandId])
}

/**
 * Benzer ürün ilişkisi (aile↔aile). Simetrik tutulur: her çift iki yönlü
 * (A→B ve B→A) satır olarak yazılır, böylece okuma tek kolondan yapılır.
 */
model SimilarFamily {
  id              String        @id @default(cuid())
  familyId        String
  family          ProductFamily @relation("FamilyToSimilar", fields: [familyId], references: [id], onDelete: Cascade)
  similarFamilyId String
  similarFamily   ProductFamily @relation("SimilarToFamily", fields: [similarFamilyId], references: [id], onDelete: Cascade)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())

  @@unique([familyId, similarFamilyId])
  @@index([familyId])
  @@index([similarFamilyId])
}

model FamilyClickStat {
  familyId  String        @id
  family    ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  count     Int           @default(0)
  updatedAt DateTime      @updatedAt

  @@index([count])
}

/**
 * Olay düzeyinde tıklama kaydı: hangi aileye, kim (bayi/plasiyer), ne zaman,
 * kaç kez. Toplu gönderimde her aile için bir satır (sayı ile). Bayi/plasiyer
 * ve tarih bazlı raporlar bundan üretilir.
 */
model FamilyClickEvent {
  id            String        @id @default(cuid())
  familyId      String
  family        ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  deviceId      String?
  salespersonId String?
  salesperson   Salesperson?  @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  /** "dealer" | "salesperson" | "unknown" */
  actorType     String        @default("unknown")
  /** Bayi adı veya plasiyer adı (o anki anlık kopya). */
  actorName     String?
  count         Int           @default(1)
  createdAt     DateTime      @default(now())

  @@index([familyId, createdAt])
  @@index([salespersonId, createdAt])
  @@index([createdAt])
}

model ProductVariant {
  id            String        @id @default(cuid())
  familyId      String
  family        ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  size          String
  surface       Surface
  quality       Quality
  feature3D     Boolean       @default(false)
  featureRec    Boolean       @default(false)
  code          String?
  /** Netsis stok kodları — bir varyantın birden çok kodu olabilir. */
  netsisCodes   VariantNetsisCode[]
  price          Int?
  palletM2      Float?
  boxM2         Float?
  truckM2       Float?
  imageUrl       String?
  imagePublicId  String?
  imageUpdatedAt DateTime?
  isActive       Boolean       @default(true)
  /** Manuel stok kilidi: true ise Netsis otomasyonu bu varyantı atlar (manuel değer korunur). */
  stockLocked    Boolean       @default(false)
  stockLockedAt  DateTime?
  stockLines StockLine[]
  orderLines OrderLine[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([familyId, size, surface, quality, feature3D, featureRec])
  @@index([familyId, size])
}

model VariantNetsisCode {
  id        String         @id @default(cuid())
  /** Netsis stok kodu — global benzersiz; tek bir varyanta işaret eder. */
  code      String         @unique
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@index([variantId])
}

model StockLine {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  label       String
  quantityM2  Float
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([variantId])
}

model Salesperson {
  id                String      @id @default(cuid())
  name              String
  isActive          Boolean     @default(true)
  showStock         Boolean     @default(true)
  /** Admin'in plasiyer bazında açtığı ürün segmenti filtre aracı yetkisi. */
  filterToolEnabled Boolean     @default(false)
  lockedDeviceId    String?     @unique
  lockedDevice   Device?     @relation("SalespersonDeviceLock", fields: [lockedDeviceId], references: [id], onDelete: SetNull)
  /** Doluysa bu plasiyer kullanıcı adı/şifreyle sınırsız cihazdan giriş
   *  yapabilir (bkz. salesperson-account.ts) - lockedDeviceId bu modda hiç
   *  kullanılmaz. Admin panelinden atanır, plasiyerin kendi kaydolduğu bir
   *  akış YOK (bayiden farkı budur). */
  username          String?     @unique
  /** scrypt hash (bkz. src/lib/password.ts) */
  password          String?
  passwordChangedAt DateTime?
  devices        Device[]
  accessRequests AccessRequest[]
  orders         Order[]
  visits         SiteVisit[]
  clickEvents    FamilyClickEvent[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

/**
 * Kullanıcı adı/şifre ile giriş yapan bayi hesabı. Bayi kendi başına kayıt olur
 * (status: PENDING), admin onaylayınca (APPROVED) bu kullanıcı adı/şifre ile
 * herhangi bir cihazdan giriş yapılabilir hale gelir — giriş her seferinde o
 * cihaz için ayrı bir Device kaydı ve token oluşturur (bkz. dealer-account.ts).
 */
model Dealer {
  id                String               @id @default(cuid())
  name              String
  username          String               @unique
  /** scrypt hash (bkz. src/lib/password.ts) */
  password          String
  status            AccessRequestStatus  @default(PENDING)
  /** Onaylanmış bir bayiyi admin daha sonra geçici olarak devre dışı bırakabilir. */
  isActive          Boolean              @default(true)
  showStock         Boolean              @default(true)
  filterToolEnabled Boolean              @default(false)
  rejectionReason   String?
  approvedByAdminId String?
  approvedByAdmin   AdminUser?           @relation("DealerApprovedBy", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  /** Şifre her değiştiğinde güncellenir (ileride şifre sıfırlama için). */
  passwordChangedAt DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  devices           Device[]

  @@index([status, createdAt])
}

model Device {
  id                 String       @id @default(cuid())
  token              String       @unique @default(cuid())
  salespersonId      String?
  salesperson        Salesperson? @relation(fields: [salespersonId], references: [id])
  lockForSalesperson Salesperson? @relation("SalespersonDeviceLock")
  /** Kullanıcı adı/şifre ile giriş yapmış bayi cihazı. Aynı bayi birden çok cihazdan giriş yapabilir. */
  dealerId           String?
  dealer             Dealer?      @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  /**
   * Eski (kullanıcı adı/şifre öncesi) tek-seferlik bayi cihazları için stok görünürlüğü.
   * dealerId doluysa bunun yerine Dealer.showStock kullanılır (bkz. resolveStockVisibility).
   */
  showStock          Boolean      @default(false)
  /**
   * Eski tek-seferlik bayi cihazları için filtre aracı yetkisi.
   * dealerId doluysa bunun yerine Dealer.filterToolEnabled kullanılır (bkz. resolveFilterToolAccess).
   */
  filterToolEnabled  Boolean      @default(false)
  label              String?
  registeredAt       DateTime     @default(now())
  lastSeenAt         DateTime     @default(now())
  visits             SiteVisit[]
  accessRequests     AccessRequest[]
}

model SiteVisit {
  id            String       @id @default(cuid())
  deviceId      String?
  device        Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  salespersonId String?
  salesperson   Salesperson? @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([createdAt])
  @@index([salespersonId, createdAt])
}

model Order {
  id                String         @id @default(cuid())
  orderNumber       String         @unique
  salespersonId     String?
  salesperson       Salesperson?   @relation(fields: [salespersonId], references: [id])
  dealerName        String
  notes             String?
  correctionNote    String?
  status            OrderStatus    @default(NEW)
  approvedByAdminId String?
  approvedByAdmin   AdminUser?     @relation("OrderApprovedBy", fields: [approvedByAdminId], references: [id])
  approvedAt        DateTime?
  lines             OrderLine[]
  adminLogs         OrderAdminLog[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
}

model OrderAdminLog {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  adminName   String
  action      String
  message     String?
  createdAt   DateTime  @default(now())

  @@index([orderId])
}

model OrderLine {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  quantityM2       Float
  unitPriceSnapshot Int
  productLabel     String

  @@index([orderId])
}

model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String
  /** Şifre her değiştiğinde güncellenir; eski oturum cookie'lerini geçersizler. */
  passwordChangedAt DateTime @default(now())
  role      AdminRole @default(BRAND_MANAGER)
  brandId   String?
  brand     Brand?    @relation(fields: [brandId], references: [id])
  /** JSON dizi: families, images, prices, ... — null ise role varsayılanı */
  permissions String?
  approvedOrders Order[]         @relation("OrderApprovedBy")
  orderLogs      OrderAdminLog[]
  accessRequests AccessRequest[] @relation("AccessRequestApprovedBy")
  dealersApproved Dealer[]        @relation("DealerApprovedBy")
  auditLogs      AdminAuditLog[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  /**
   * Otomatik fiyat güncelleme duyurusu için marka referansı (manuel/genel duyurularda null).
   * Doluysa fiyat güncellemesi bu markanın duyurusunu bulup günceller (bkz. src/lib/announcements.ts).
   */
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
}

/**
 * Admin denetim izi: kritik yönetim işlemlerinin (fiyat/stok/ürün/renk-tip/
 * marka/netsis/satış vb.) kim tarafından ne zaman yapıldığını tutar.
 */
model AdminAuditLog {
  id          String    @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  adminName   String
  /** Kısa işlem kodu: "price.update", "stock.import", "family.attributes" ... */
  action      String
  /** İlgili varlık tipi: "family" | "variant" | "brand" | "settings" ... */
  entityType  String?
  entityId    String?
  /** İnsan-okur özet ("12 ürünün stoğu güncellendi" gibi). */
  summary     String?
  /** Ek ayrıntılar JSON (opsiyonel). */
  meta        String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([adminUserId, createdAt])
}

/**
 * Netsis stok senkronizasyon kaydı. Her içe aktarım (manuel veya ajan) bir
 * satır yazar: kaynak, sonuç sayıları, kilitli-atlanan/eşleşmeyen ve hata özeti.
 * İzleme ekranı ve anomali uyarısı bundan beslenir.
 */
model NetsisSyncLog {
  id              String   @id @default(cuid())
  /** "agent" | "manual" */
  source          String
  fileName        String?
  totalCodes      Int      @default(0)
  matchedCodes    Int      @default(0)
  unmatchedCount  Int      @default(0)
  variantsUpdated Int      @default(0)
  lockedSkipped   Int      @default(0)
  zeroBalance     Int      @default(0)
  dryRun          Boolean  @default(false)
  ok              Boolean  @default(true)
  message         String?
  /** Eşleşmeyen kodların bir kısmı (JSON dizi, kısaltılmış). */
  unmatchedSample String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
}

model AppSettings {
  id                   String   @id @default("default")
  lastPriceListUpdate  DateTime @default(now())
  /** Katalogdan satış (sepet/sipariş) açık mı? Kapalıyken sepet gizlenir. */
  salesEnabled         Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model AccessRequest {
  id                  String              @id @default(cuid())
  type                AccessRequestType
  status              AccessRequestStatus @default(PENDING)
  salespersonId       String?
  salesperson         Salesperson?        @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  dealerName          String?
  requestToken        String              @unique
  requestLabel        String
  deviceId            String?
  device              Device?             @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  approvedByAdminId   String?
  approvedByAdmin     AdminUser?          @relation("AccessRequestApprovedBy", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  rejectionReason     String?
  notifiedAt          DateTime?
  approvedAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([salespersonId, status])
}

/**
 * Kampanya afişi: banner-studio'da hazırlanan PDF'in dışa aktarılmış sayfa
 * görselleri (bkz. CampaignImage). Herkese açık kataloğun "Kampanyalar"
 * bölümünde gösterilir; yönetimi admin-only "campaigns" izniyle sınırlıdır.
 */
model Campaign {
  id               String          @id @default(cuid())
  title            String
  description      String?
  isActive         Boolean         @default(true)
  /** false ise yalnızca plasiyerlere görünür (Brand.visibleToDealers ile aynı desen). */
  visibleToDealers Boolean         @default(true)
  sortOrder        Int             @default(0)
  /** Kart/liste görünümünde yuvarlak rozet olarak gösterilir (bkz. src/lib/campaign-tags.ts). Üçü de opsiyonel. */
  locationTag      String?
  sizeTag          String?
  qualityTag       String?
  images           CampaignImage[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model CampaignImage {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  imageUrl      String
  imagePublicId String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([campaignId])
}

/**
 * Admin-only ürün segmenti filtresi: marka/malzeme/kalite/stok eşiğine göre
 * tanımlanmış, isimlendirilip tekrar çalıştırılabilen sorgu (örn. "Güral
 * 250 m² altı ürünler"). Sonuç DB'de saklanmaz; her çalıştırmada güncel
 * stoktan hesaplanır (bkz. src/lib/campaign-filter.ts).
 */
model ProductFilterPreset {
  id               String          @id @default(cuid())
  name             String
  /** JSON dizi: marka id'leri (boş dizi = tüm markalar). */
  brandIds         String          @default("[]")
  materialType     String?
  quality          Quality?
  basis            FilterBasis
  /** Aralığın alt sınırı (dahil, "üstü"); null = alt sınır yok. */
  minM2            Float?
  /** Aralığın üst sınırı (dahil değil, "altı"); null = üst sınır yok. */
  maxM2            Float?
  /** JSON dizi: ebat değerleri, örn. ["60x120"] (boş dizi = tüm ebatlar). */
  sizes            String          @default("[]")
  /** JSON dizi: Surface enum değerleri, örn. ["MAT"] (boş dizi = tüm yüzeyler). */
  surfaces         String          @default("[]")
  createdByAdminId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}
